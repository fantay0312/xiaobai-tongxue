[Unit]
Description=Xiaobai classmate gateway (static + auth + LLM proxy)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=xiaobai
Group=xiaobai
WorkingDirectory=/opt/xiaobai/server
# 可选密钥文件(0600,root 持有):Resend 与腾讯云验证码/CAM 调用凭据
EnvironmentFile=-/etc/xiaobai/xiaobai.env
ExecStartPre=/usr/bin/node /opt/xiaobai/server/check-runtime.mjs
ExecStart=/usr/bin/node /opt/xiaobai/server/index.mjs
Restart=always
RestartSec=3
TimeoutStopSec=20
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/opt/xiaobai
# PostgreSQL/COS 是生产主存储；StateDirectory 保留迁移源与可回滚的旧 JSON/文件。
StateDirectory=xiaobai
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
