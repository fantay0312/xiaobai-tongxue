# 生产部署必须替换成拉取并验收过的 sha256 digest；这里的 tag 只供首次拉取。
WEKNORA_APP_IMAGE=wechatopenai/weknora-app:latest
WEKNORA_DOCREADER_IMAGE=wechatopenai/weknora-docreader:latest
WEKNORA_POSTGRES_IMAGE=paradedb/paradedb:v0.22.2-pg17
WEKNORA_REDIS_IMAGE=redis:7.0-alpine
WK_BIND_PORT=8180

DB_USER=weknora
DB_PASSWORD=replace-with-random-password
DB_NAME=weknora
REDIS_PASSWORD=replace-with-random-password

# SYSTEM_AES_KEY 必须恰好 32 字节；可用 `openssl rand -hex 16`。
SYSTEM_AES_KEY=replace-with-32-byte-value
JWT_SECRET=replace-with-long-random-value
GRPC_AUTH_TOKEN=replace-with-long-random-value

# 首次创建集成账号时临时改成 false；创建 API Key 后立即恢复 true。
DISABLE_REGISTRATION=true
